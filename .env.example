# ==============================================================================
# Vercel Production Environment Variables
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Supabase Project URL (Required, Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anon Key (Required, Client & Server)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Publishable Key (Optional modern alias)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase Service Role Key (Required, Server-side API endpoints & RBAC)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Application Public URL (Optional on Vercel - auto-detects VERCEL_URL if not provided)
NEXT_PUBLIC_APP_URL="https://your-production-app.vercel.app"
